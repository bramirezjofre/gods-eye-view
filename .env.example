# Copy this file to .env and fill in the keys you have. Leave the rest
# blank — the relevant layers will be empty or fall back to a simulation.
# See DATA_SOURCES.md in the repo for per-source terms and attribution.

# Build-time public keys (baked into the client bundle).
# VITE_CESIUM_ION_TOKEN=
# VITE_GOOGLE_MAPS_API_KEY=

# Runtime server-side keys.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# TOMTOM_API_KEY=
# FIRMS_MAP_KEY=
# AISSTREAM_API_KEY=
# LL2_API_TOKEN=
# TFL_APP_KEY=
# OPENAI_API_KEY=